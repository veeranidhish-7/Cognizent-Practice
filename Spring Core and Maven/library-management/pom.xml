<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Exercise 9 asks for a Spring Boot project created via Spring Initializr.
        Rather than starting a second project, we use spring-boot-starter-parent
        here so this single project can host both:
          - the classic, XML-configured Spring beans used in Exercises 1,2,3,5,6,7,8
          - the Spring Boot / JPA / REST app used in Exercise 9
        Spring Boot's auto-configuration only scans com.library.boot (the package
        of the @SpringBootApplication class), so it never touches the manually
        wired classic beans in com.library.service / com.library.repository.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.library</groupId>
    <artifactId>library-management</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>LibraryManagement</name>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ===================================================================
             Classic Spring (IoC / DI / AOP) - Exercises 1, 2, 3, 5, 6, 7, 8
             Versions are managed by the spring-boot-starter-parent BOM above.
             =================================================================== -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- ===================================================================
             Spring Boot - Exercise 9 (Web + Data JPA + H2)
             =================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Only the Exercise 9 app is meant to run as a packaged Boot jar.
                         The Exercises 1-8 demo classes are run directly from the IDE. -->
                    <mainClass>com.library.boot.LibraryManagementBootApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
